\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{paper-common}[2026/08/30 Shared setup for William Ford's papers]

% Page layout and general document tools
\RequirePackage[utf8]{inputenc}
\RequirePackage[a4paper,top=3cm,bottom=3cm,left=3cm,right=3cm]{geometry}
\pagestyle{plain}
\setlength{\marginparwidth}{2cm}

% Draft notes
\RequirePackage{xargs}
\RequirePackage[pdftex,dvipsnames]{xcolor}
\RequirePackage[colorinlistoftodos,prependcaption,textsize=tiny]{todonotes}
\makeatletter
\providecommand\@dotsep{5}
\renewcommand{\listoftodos}[1][\@todonotes@todolistname]{\@starttoc{tdo}{#1}}
\makeatother

% Mathematics
\RequirePackage{mathtools,amsfonts,amsthm,amssymb,mathrsfs}
\RequirePackage{dsfont}
\RequirePackage{derivative}
\RequirePackage[shortlabels]{enumitem}
\setlist[enumerate]{nosep}
\numberwithin{equation}{section}

% Theorem environments
\theoremstyle{plain}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{assumption}[theorem]{Assumption}
\newtheorem*{theorem*}{Theorem}
\newtheorem{problem}{Problem}
\newtheorem{openproblem}{Open problem}

\theoremstyle{definition}
\newtheorem{example}[theorem]{Example}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{remark}[theorem]{Remark}

