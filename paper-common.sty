% Bibliography. Each project chooses its checked-in resource with
% \addbibresource in main.tex.
\RequirePackage[backend=biber]{biblatex}

% Figures and diagrams
\RequirePackage{tikz}
\usetikzlibrary{shapes.misc,arrows.meta,calc,decorations.pathreplacing,positioning}
\tikzset{
  cross/.style={
    cross out,
    draw=black,
    minimum size=2*(#1-\pgflinewidth),
    inner sep=0pt,
    outer sep=0pt
  },
  cross/.default={1pt}
}
\RequirePackage{caption}

% Shared colors
\definecolor{beamerblue}{RGB}{51,51,178}
\definecolor{targetcolour}{RGB}{51,51,178}
\definecolor{sourcecolour}{RGB}{216,0,240}
\definecolor{mixed}{RGB}{255,0,0}
