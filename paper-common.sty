% Nomenclature and links
\RequirePackage{nomentbl}
\RequirePackage{hyperref}

% Reusable footnote helpers
\newcommand{\footremember}[2]{%
  \footnote{#2}%
  \newcounter{#1}%
  \setcounter{#1}{\value{footnote}}%
}
\newcommand{\footrecall}[1]{\footnotemark[\value{#1}]}

% Numbered proof steps
\newcounter{step}
\newcommand{\step}{%
  \refstepcounter{step}%
  \textbf{\vspace{1mm}\\\noindent Step \thestep: }%
}
\newcommand{\resetstep}{\setcounter{step}{0}}
